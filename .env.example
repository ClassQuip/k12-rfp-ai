# OpenAI (required for structured extraction)
OPENAI_API_KEY=sk-your-key-here

# AWS S3 (required for uploads; omit to run in dry-run mode without S3)
AWS_S3_BUCKET_NAME=your-private-k12-rfp-bucket
AWS_REGION=us-east-1

# Optional: skip S3 uploads when set to 1 (useful for local dev)
SKIP_S3_UPLOAD=0

# Optional: GitHub Actions OIDC (set in repo secrets, not locally)
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-k12-rfp-ai
